<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/padding_2x"
    android:paddingVertical="@dimen/padding">

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/questionView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="怎么使用本软件？"
        android:textAppearance="@style/TextAppearance.Material3.TitleMedium.Emphasized"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/answerView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_half"
        android:text="本软件不对目标应用做侵入式攻击，不修改定位数据，可以放心使用。只需要设置好任务时间，本软件会在设置的时间点附近调起目标应用实现自动打卡（初次使用会有个弹框提示，“DailyTask”想要打开的目标应用，勾选“始终允许”），但是需要长亮屏幕，因为锁屏后再解锁，并不会直接进入桌面，会无法调起软件。"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:textColor="@color/text_secondary_color"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/questionView" />
</androidx.constraintlayout.widget.ConstraintLayout>
