<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/back_ground_color"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="@drawable/ic_title_left"
        app:title="任务配置"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium.Emphasized"
        app:titleTextColor="@color/text_default_color" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/padding_2x">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="时间与口令"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall.Emphasized"
                android:textColor="#ABABAB" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_half"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@color/border_color">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/divider_line"
                    android:dividerPadding="@dimen/padding_2x"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <com.pengxh.daily.app.widget.SettingItemView
                        android:id="@+id/resetTimeItem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:itemDesc="每天几点重新开始计算当日任务"
                        app:itemRightType="text"
                        app:itemTitle="重置时间" />

                    <com.pengxh.daily.app.widget.SettingItemView
                        android:id="@+id/timeoutItem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:itemDesc="停留在目标应用的时间"
                        app:itemRightType="text"
                        app:itemTitle="超时时间" />

                    <com.pengxh.daily.app.widget.SettingItemView
                        android:id="@+id/keyItem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:itemDesc="远程触发打卡时使用的指令内容"
                        app:itemRightType="text"
                        app:itemTitle="任务口令" />

                    <LinearLayout
                        android:id="@+id/workdayLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="@dimen/padding_2x"
                        android:paddingVertical="@dimen/dp_12">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="vertical">

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:text="工作日设置"
                                android:textAppearance="@style/TextAppearance.Material3.TitleSmall" />

                            <com.google.android.material.textview.MaterialTextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="end"
                                android:singleLine="true"
                                android:text="非工作日自动跳过任务"
                                android:textSize="@dimen/smallest_text_size" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/workdayValueView"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/margin_2x"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_marginBottom="@dimen/margin_half"
                android:text="执行策略"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall.Emphasized"
                android:textColor="#ABABAB" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@color/border_color">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/divider_line"
                    android:dividerPadding="@dimen/padding_2x"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <com.pengxh.daily.app.widget.SettingItemView
                        android:id="@+id/skipHolidayItem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:itemDesc="法定节假日不执行打卡"
                        app:itemRightType="toggle"
                        app:itemTitle="跳过节假日" />

                    <com.pengxh.daily.app.widget.SettingItemView
                        android:id="@+id/autoTaskItem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:itemDesc="仅能通过远程指令「DT#开启/关闭循环」修改"
                        app:itemDescColor="@color/failure_color"
                        app:itemRightType="toggle"
                        app:itemTitle="循环任务" />

                    <com.pengxh.daily.app.widget.SettingItemView
                        android:id="@+id/randomTimeItem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:itemDesc="在时间范围内随机取点执行"
                        app:itemRightType="toggle"
                        app:itemTitle="随机时间" />

                    <com.pengxh.daily.app.widget.SettingItemView
                        android:id="@+id/minuteRangeItem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:itemRightType="text"
                        app:itemTitle="时间范围" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_marginBottom="@dimen/margin_half"
                android:text="配置迁移"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall.Emphasized"
                android:textColor="#ABABAB" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@color/border_color">

                <com.pengxh.daily.app.widget.SettingItemView
                    android:id="@+id/exportItem"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:itemDesc="分享到 QQ / 微信 / TIM / 支付宝，或复制到剪贴板"
                    app:itemRightType="arrow"
                    app:itemTitle="导出配置" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
