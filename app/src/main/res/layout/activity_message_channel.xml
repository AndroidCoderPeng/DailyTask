<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/back_ground_color"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="@drawable/ic_title_left"
        app:title="消息渠道"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium.Emphasized"
        app:titleTextColor="@color/text_default_color" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/padding_2x">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@color/border_color">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/padding_2x">

                    <RadioGroup
                        android:id="@+id/channelRadioGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/wxRadioButton"
                            style="@style/ChannelRadioButtonStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:drawableTop="@drawable/ic_channel_work"
                            android:text="企业微信" />

                        <Space
                            android:layout_width="@dimen/margin"
                            android:layout_height="wrap_content" />

                        <com.google.android.material.radiobutton.MaterialRadioButton
                            android:id="@+id/qqRadioButton"
                            style="@style/ChannelRadioButtonStyle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:drawableTop="@drawable/ic_channel_email"
                            android:text="QQ 邮箱" />
                    </RadioGroup>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/margin_half"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="群机器人 Webhook"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="#ABABAB" />

                        <Space
                            android:layout_width="@dimen/margin"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="SMTP 授权码发信"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="#ABABAB" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 消息标题 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_2x"
                android:layout_marginBottom="@dimen/margin_half"
                android:text="消息标题"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall.Emphasized"
                android:textColor="#ABABAB" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@color/border_color">

                <com.pengxh.daily.app.widget.DeletableEditText
                    android:id="@+id/messageTitleView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/margin_2x"
                    android:background="@drawable/bg_edit_text_stroke_8"
                    android:gravity="center_vertical"
                    android:hint="如：打卡结果通知（非必填）"
                    android:paddingHorizontal="@dimen/dp_12"
                    android:paddingVertical="10dp"
                    android:singleLine="true"
                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
            </com.google.android.material.card.MaterialCardView>

            <!-- 企业微信 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_2x"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_half"
                    android:text="企业微信"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall.Emphasized"
                    android:textColor="#ABABAB" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/white"
                    app:strokeColor="@color/border_color">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="@dimen/padding_2x">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/margin_half"
                            android:text="Webhook Key"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall.Emphasized"
                            android:textColor="#ABABAB" />

                        <com.pengxh.daily.app.widget.DeletableEditText
                            android:id="@+id/wxKeyView"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@drawable/bg_edit_text_stroke_8"
                            android:gravity="center_vertical"
                            android:paddingHorizontal="@dimen/dp_12"
                            android:paddingVertical="10dp"
                            android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="@dimen/margin_half"
                            android:text="群聊设置 → 消息推送 → 复制地址末尾的 key"
                            android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                            android:textColor="#ABABAB" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="@dimen/margin"
                            android:orientation="horizontal">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/stateCardView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:cardBackgroundColor="@color/back_ground_color"
                                app:strokeWidth="0dp">

                                <TextView
                                    android:id="@+id/stateTextView"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="@dimen/margin_2x"
                                    android:layout_marginVertical="@dimen/margin_half"
                                    android:text="未配置"
                                    android:textAppearance="@style/TextAppearance.Material3.BodySmall.Emphasized"
                                    android:textColor="@color/text_secondary_color" />
                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:id="@+id/updateTimeView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginVertical="@dimen/margin_half"
                                android:layout_marginStart="@dimen/margin"
                                android:text="测试发送成功后才保存"
                                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                                android:textColor="#ABABAB"
                                tools:text="配置保存于 2026-10-28 14:02" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/sendWxButton"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="发送测试推送"
                            app:cornerRadius="@dimen/radius"
                            app:strokeColor="@color/theme_color" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- QQ 邮箱 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/margin_2x"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_half"
                    android:text="QQ 邮箱"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall.Emphasized"
                    android:textColor="#ABABAB" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/margin_2x"
                    app:cardBackgroundColor="@color/white"
                    app:strokeColor="@color/border_color">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="vertical"
                        android:padding="@dimen/padding_2x">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="发件箱"
                                android:textAppearance="@style/TextAppearance.Material3.BodyMedium.Emphasized"
                                android:textColor="@color/text_secondary_color" />

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin"
                                android:orientation="horizontal">

                                <com.pengxh.daily.app.widget.DeletableEditText
                                    android:id="@+id/emailSendAddressView"
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:background="@drawable/bg_edit_text_stroke_8"
                                    android:gravity="center_vertical"
                                    android:hint="如：123456789"
                                    android:inputType="number"
                                    android:paddingHorizontal="@dimen/dp_12"
                                    android:paddingVertical="10dp"
                                    android:singleLine="true"
                                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="match_parent"
                                    android:layout_marginStart="@dimen/margin"
                                    android:background="@drawable/bg_edit_text_stroke_8"
                                    android:gravity="center_vertical"
                                    android:paddingHorizontal="@dimen/padding_2x"
                                    android:text="\@qq.com"
                                    android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
                            </LinearLayout>
                        </LinearLayout>

                        <com.google.android.material.divider.MaterialDivider
                            android:layout_width="match_parent"
                            android:layout_height="1px"
                            android:layout_marginVertical="@dimen/margin_2x"
                            android:background="@drawable/divider_line" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="授权码"
                                android:textAppearance="@style/TextAppearance.Material3.BodyMedium.Emphasized"
                                android:textColor="@color/text_secondary_color" />

                            <com.pengxh.daily.app.widget.DeletableEditText
                                android:id="@+id/emailSendCodeView"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginVertical="@dimen/margin_half"
                                android:background="@drawable/bg_edit_text_stroke_8"
                                android:gravity="center_vertical"
                                android:paddingHorizontal="@dimen/dp_12"
                                android:paddingVertical="10dp"
                                android:singleLine="true"
                                android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="使用 SMTP 授权码，非邮箱登录密码"
                                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                                android:textColor="#ABABAB" />
                        </LinearLayout>

                        <com.google.android.material.divider.MaterialDivider
                            android:layout_width="match_parent"
                            android:layout_height="1px"
                            android:layout_marginVertical="@dimen/margin_2x"
                            android:background="@drawable/divider_line" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="收件箱"
                                android:textAppearance="@style/TextAppearance.Material3.BodyMedium.Emphasized"
                                android:textColor="@color/text_secondary_color" />

                            <com.pengxh.daily.app.widget.DeletableEditText
                                android:id="@+id/emailInboxView"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/margin_half"
                                android:background="@drawable/bg_edit_text_stroke_8"
                                android:gravity="center_vertical"
                                android:hint="如：xxxxx@qq.com"
                                android:inputType="textEmailAddress"
                                android:paddingHorizontal="@dimen/dp_12"
                                android:paddingVertical="10dp"
                                android:singleLine="true"
                                android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginVertical="@dimen/margin"
                            android:orientation="horizontal">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/qqStateCardView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                app:cardBackgroundColor="@color/back_ground_color"
                                app:strokeWidth="0dp">

                                <TextView
                                    android:id="@+id/qqStateTextView"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginHorizontal="@dimen/margin_2x"
                                    android:layout_marginVertical="@dimen/margin_half"
                                    android:text="未配置"
                                    android:textAppearance="@style/TextAppearance.Material3.BodySmall.Emphasized"
                                    android:textColor="@color/text_secondary_color" />
                            </com.google.android.material.card.MaterialCardView>

                            <TextView
                                android:id="@+id/qqUpdateTimeView"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginVertical="@dimen/margin_half"
                                android:layout_marginStart="@dimen/margin"
                                android:text="测试发送成功后才保存"
                                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                                android:textColor="#ABABAB"
                                tools:text="配置保存于 2026-10-28 14:02" />
                        </LinearLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/sendEmailButton"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="发送测试邮件"
                            app:cornerRadius="@dimen/radius"
                            app:strokeColor="@color/theme_color" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>