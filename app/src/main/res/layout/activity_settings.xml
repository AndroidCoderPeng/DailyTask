<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/back_ground_color"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:navigationIcon="@drawable/ic_title_left"
        app:title="设置"
        app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium.Emphasized"
        app:titleTextColor="@color/text_default_color" />

    <androidx.core.widget.NestedScrollView
        android:id="@+id/contentView"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/padding_2x">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_half"
                android:text="任务目标"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall.Emphasized"
                android:textColor="#ABABAB" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@color/border_color">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/divider_line"
                    android:dividerPadding="@dimen/padding_2x"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <com.pengxh.daily.app.widget.SettingItemView
                        android:id="@+id/targetAppItem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:itemIcon="@drawable/ic_setting_target"
                        app:itemRightTextColor="@color/theme_color"
                        app:itemRightType="text"
                        app:itemTitle="目标应用" />

                    <com.pengxh.daily.app.widget.SettingItemView
                        android:id="@+id/msgChannelItem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:itemDesc="打卡结果回推渠道"
                        app:itemIcon="@drawable/ic_setting_message"
                        app:itemRightType="text"
                        app:itemTitle="消息渠道" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="@dimen/padding_2x"
                        android:paddingVertical="@dimen/dp_12">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="结果来源"
                            android:textAppearance="@style/TextAppearance.Material3.TitleSmall" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="用哪种方式判定「打卡成功」"
                            android:textSize="@dimen/smallest_text_size" />

                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/margin"
                            app:cardBackgroundColor="@color/back_ground_color"
                            app:strokeWidth="0dp">

                            <RadioGroup
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_margin="@dimen/margin_half"
                                android:orientation="horizontal">

                                <com.google.android.material.radiobutton.MaterialRadioButton
                                    android:id="@+id/noticeRadioButton"
                                    style="@style/CustomRadioButtonStyle"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:text="通知监听" />

                                <com.google.android.material.radiobutton.MaterialRadioButton
                                    android:id="@+id/captureRadioButton"
                                    style="@style/CustomRadioButtonStyle"
                                    android:layout_width="0dp"
                                    android:layout_weight="1"
                                    android:text="截屏服务" />
                            </RadioGroup>
                        </com.google.android.material.card.MaterialCardView>
                    </LinearLayout>

                    <com.pengxh.daily.app.widget.SettingItemView
                        android:id="@+id/remoteClockInCaptureItem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:itemDesc="开启后，【DT#打卡】倒计时结束会截屏并发送结果"
                        app:itemRightType="toggle"
                        app:itemTitle="返回截图" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_marginBottom="@dimen/margin_half"
                android:text="服务与权限"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall.Emphasized"
                android:textColor="#ABABAB" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@color/border_color">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/divider_line"
                    android:dividerPadding="@dimen/padding_2x"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <com.pengxh.daily.app.widget.SettingItemView
                        android:id="@+id/floatingItem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:itemDesc="核心服务，用于打卡后自动跳回本软件"
                        app:itemRightType="toggle"
                        app:itemTitle="悬浮权限" />

                    <com.pengxh.daily.app.widget.SettingItemView
                        android:id="@+id/noticeItem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:itemDesc="监听打卡结果与远程指令"
                        app:itemRightType="toggle"
                        app:itemTitle="通知监听" />

                    <com.pengxh.daily.app.widget.SettingItemView
                        android:id="@+id/captureItem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:itemDesc="截屏服务未开启，无法获取打卡结果"
                        app:itemDescColor="@color/failure_color"
                        app:itemRightType="toggle"
                        app:itemTitle="截屏服务" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_marginBottom="@dimen/margin_half"
                android:text="行为偏好"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall.Emphasized"
                android:textColor="#ABABAB" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@color/border_color">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/divider_line"
                    android:dividerPadding="@dimen/padding_2x"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <com.pengxh.daily.app.widget.SettingItemView
                        android:id="@+id/gestureItem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:itemDesc="单指上下滑动开启 / 关闭伪灭屏"
                        app:itemRightType="toggle"
                        app:itemTitle="手势辅助" />

                    <com.pengxh.daily.app.widget.SettingItemView
                        android:id="@+id/powerSaveItem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:itemDesc="降低倒计时与蒙层动画刷新频率"
                        app:itemRightType="toggle"
                        app:itemTitle="省电模式" />

                    <com.pengxh.daily.app.widget.SettingItemView
                        android:id="@+id/backHomeItem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:itemDesc="打卡结束后先回桌面再启动本软件"
                        app:itemRightType="toggle"
                        app:itemTitle="退回桌面" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_marginBottom="@dimen/margin_half"
                android:text="任务"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall.Emphasized"
                android:textColor="#ABABAB" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@color/border_color">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/divider_line"
                    android:dividerPadding="@dimen/padding_2x"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <com.pengxh.daily.app.widget.SettingItemView
                        android:id="@+id/taskConfigItem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:itemDesc="重置时间、超时、口令、工作日"
                        app:itemIcon="@drawable/ic_setting_task"
                        app:itemRightType="arrow"
                        app:itemTitle="任务配置" />

                    <com.pengxh.daily.app.widget.SettingItemView
                        android:id="@+id/updateHolidayItem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:itemDesc="同步当年与次年的法定节假日"
                        app:itemIcon="@drawable/ic_setting_holiday"
                        app:itemRightType="text"
                        app:itemTitle="更新节假日数据" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_marginBottom="@dimen/margin_half"
                android:text="工具"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall.Emphasized"
                android:textColor="#ABABAB" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@color/border_color">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/divider_line"
                    android:dividerPadding="@dimen/padding_2x"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <com.pengxh.daily.app.widget.SettingItemView
                        android:id="@+id/commandItem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:itemIcon="@drawable/ic_setting_command"
                        app:itemRightType="text"
                        app:itemTitle="全部指令" />

                    <com.pengxh.daily.app.widget.SettingItemView
                        android:id="@+id/openTestItem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:itemDesc="验证拉起目标应用"
                        app:itemIcon="@drawable/ic_setting_evoke"
                        app:itemRightType="arrow"
                        app:itemTitle="唤起测试" />

                    <com.pengxh.daily.app.widget.SettingItemView
                        android:id="@+id/captureTestItem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:itemDesc="截屏并通过消息渠道发送测试图片"
                        app:itemIcon="@drawable/ic_setting_capture"
                        app:itemRightType="arrow"
                        app:itemTitle="截屏测试" />

                    <com.pengxh.daily.app.widget.SettingItemView
                        android:id="@+id/sendLogItem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:itemDesc="打包后通过 QQ 发送，便于排查问题"
                        app:itemIcon="@drawable/ic_setting_log"
                        app:itemRightType="arrow"
                        app:itemTitle="发送日志" />

                    <com.pengxh.daily.app.widget.SettingItemView
                        android:id="@+id/introduceItem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:itemIcon="@drawable/ic_setting_faq"
                        app:itemRightType="arrow"
                        app:itemTitle="常见问题" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/dp_12"
                android:layout_marginBottom="@dimen/margin_half"
                android:text="关于"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall.Emphasized"
                android:textColor="#ABABAB" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/margin_2x"
                app:cardBackgroundColor="@color/white"
                app:strokeColor="@color/border_color">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:divider="@drawable/divider_line"
                    android:dividerPadding="@dimen/padding_2x"
                    android:orientation="vertical"
                    android:showDividers="middle">

                    <com.pengxh.daily.app.widget.SettingItemView
                        android:id="@+id/versionItem"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:itemRightType="text"
                        app:itemTitle="当前版本" />

                    <com.pengxh.daily.app.widget.SettingItemView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:itemDesc="全部配置保存在本机，不上传服务器"
                        app:itemRightType="none"
                        app:itemTitle="数据存储" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
