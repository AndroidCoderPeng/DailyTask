<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/padding_2x">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="修改任务口令"
        android:textAppearance="@style/TextAppearance.Material3.TitleMedium.Emphasized" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/margin"
        android:text="远程触发打卡时发送的指令内容"
        android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
        android:textColor="@color/text_secondary_color" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin"
        android:text="口令内容"
        android:textAppearance="@style/TextAppearance.Material3.TitleSmall.Emphasized"
        android:textColor="@color/text_secondary_color" />

    <com.pengxh.daily.app.widget.DeletableEditText
        android:id="@+id/inputView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="@dimen/margin"
        android:background="@drawable/bg_edit_text_stroke_8"
        android:gravity="center_vertical"
        android:hint="如：打卡"
        android:padding="10dp"
        android:singleLine="true"
        android:textAppearance="@style/TextAppearance.Material3.TitleMedium" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="需以「DT#」开头的指令使用，此处只填口令部分"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        android:textColor="@color/text_hint_color" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_2x"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancelButton"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="取消"
            android:textColor="@color/text_secondary_color"
            app:cornerRadius="@dimen/radius"
            app:strokeColor="@color/border_color" />

        <Space
            android:layout_width="@dimen/margin_2x"
            android:layout_height="wrap_content" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/confirmButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="保存"
            app:cornerRadius="@dimen/radius" />
    </LinearLayout>
</LinearLayout>