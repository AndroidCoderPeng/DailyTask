<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="CustomSwitchStyle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:thumb">@drawable/bg_switch_thumb</item>
        <item name="track">@drawable/bg_switch_track</item>
        <item name="thumbTint">@null</item>
        <item name="trackTint">@null</item>
    </style>

    <style name="CustomRadioButtonStyle">
        <item name="android:layout_height">38dp</item>
        <item name="android:background">@drawable/selector_radio_button</item>
        <item name="android:button">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.TitleSmall.Emphasized
        </item>
        <item name="android:textColor">@color/text_selector_color</item>
    </style>
</resources>