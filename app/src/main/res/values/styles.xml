<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- parent 不能省：提供 textOn/textOff 默认值，否则 SwitchCompat.makeLayout 会 NPE -->
    <style name="CustomSwitchStyle" parent="Widget.AppCompat.CompoundButton.Switch">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:thumb">@drawable/bg_switch_thumb</item>
        <item name="track">@drawable/bg_switch_track</item>
        <item name="thumbTint">@null</item>
        <item name="trackTint">@null</item>
    </style>

    <style name="CustomRadioButtonStyle">
        <item name="android:layout_height">36dp</item>
        <item name="android:background">@drawable/selector_radio_button</item>
        <item name="android:button">@null</item>
        <item name="android:gravity">center</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.TitleSmall.Emphasized
        </item>
        <item name="android:textColor">@color/text_selector_color</item>
    </style>

    <style name="ChannelRadioButtonStyle">
        <item name="android:paddingVertical">@dimen/dp_12</item>
        <item name="android:drawablePadding">@dimen/padding_half</item>
        <item name="android:button">@null</item>
        <item name="android:background">@drawable/selector_channel_radio</item>
        <item name="android:gravity">center</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.TitleSmall.Emphasized
        </item>
        <item name="android:textColor">@color/text_selector_channel</item>
    </style>
</resources>